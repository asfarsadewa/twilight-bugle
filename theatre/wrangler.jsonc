// The Twilight Bugle on Cloudflare Workers. Build first (bun run build), then deploy (wrangler deploy).
// Secrets, never in this file: TURNSTILE_SECRET (the "orders" widget) and PASS_KEY (signs the pass cookie).
{
  "name": "twilight-bugle",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/show/*", "/assets/*", "/house/*"]
  },
  "routes": [{ "pattern": "twilightbugle.asfarlab.fun", "custom_domain": true }],
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAAE83S_FcNe-nFfpO",
    "TURNSTILE_HOSTNAMES": "twilightbugle.asfarlab.fun"
  },
  "observability": { "enabled": true }
}
