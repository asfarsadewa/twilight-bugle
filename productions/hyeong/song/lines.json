 },
 {
  "section": "v2",
  "who": "min",
  "ko": "그게 나라서 다행이야",
  "id": "Syukurlah, itu aku",
  "en": "I am glad that it is me",
  "sung": "그게 나라서 다행이야"
 },
 {
  "section": "bridge",
