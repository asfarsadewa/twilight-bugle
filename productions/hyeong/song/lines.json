[
 {
  "section": "v1",
  "who": "min",
  "ko": "장마비 내리던 6월의 아침",
  "id": "Pagi bulan Juni, hujan tak henti",
  "en": "A June morning in the monsoon rain",
  "sung": "장마비 내리던 6월의 아침"
 },
 {
  "section": "v1",
  "who": "min",
  "ko": "우린 같은 길을 걸어 나서지",
  "id": "Kita melangkah di jalan yang sama",
  "en": "We set out on the same road",
  "sung": "우린 같은 길을 걸어 나서지"
 },
 {
  "section": "v1",
  "who": "min",
  "ko": "누가 친구고 누가 남인지",
  "id": "Siapa kawan, siapa orang asing",
  "en": "Who was a friend, who was a stranger",
  "sung": "누가 친구고 누가 남인지"
 },
 {
  "section": "v1",
  "who": "min",
  "ko": "아무도 모르는 안개 속에서",
  "id": "Tak ada yang tahu, di dalam kabut",
  "en": "No one could tell, in the fog",
  "sung": "아무도 모르는 안개 속에서"
 },
 {
  "section": "v1",
  "who": "min",
  "ko": "떨리는 내 손을 네가 잡아줬지",
  "id": "Kau genggam tanganku yang gemetar",
  "en": "You took my trembling hand",
  "sung": "떨리는 내 손을 네가 잡아줬지"
 },
 {
  "section": "v1",
  "who": "min",
  "ko": "괜찮아 우린 형제니까",
  "id": "Tak apa, kita bersaudara",
  "en": "It is all right, we are brothers",
  "sung": "괜찮아 우린 형제니까"
 },
 {
  "section": "ch1",
  "who": "min",
  "ko": "형 먼저 가",
  "id": "Kak, pergilah dulu",
  "en": "Hyung, go first",
  "sung": "형 먼저 가"
 },
 {
  "section": "ch1",
  "who": "min",
  "ko": "이 다리는 내가 지키게",
  "id": "Jembatan ini biar aku yang jaga",
  "en": "Let me hold this bridge",
  "sung": "이 다리는 내가 지키게"
 },
 {
  "section": "ch1",
  "who": "min",
  "ko": "뒤돌아보지 말고 가",
  "id": "Pergilah, jangan menoleh",
  "en": "Go, and do not look back",
  "sung": "뒤돌아보지 말고 가"
 },
 {
  "section": "ch1",
  "who": "min",
  "ko": "꼭 살아서 집에 가",
  "id": "Kau harus hidup, pulanglah",
  "en": "Stay alive, and get home",
  "sung": "꼭 살아서 집에 가"
 },
 {
  "section": "v2",
  "who": "min",
  "ko": "엄마가 싸 준 주먹밥 한쪽",
  "id": "Sekepal nasi bekal dari ibu",
  "en": "The rice ball Mother packed for us",
  "sung": "엄마가 싸 준 주먹밥 한쪽"
 },
 {
  "section": "v2",
  "who": "min",
  "ko": "너에게 건네던 그 밤을 기억해",
  "id": "Kuingat malam saat kuberikan padamu",
  "en": "I remember the night I gave it to you",
  "sung": "너에게 건네던 그 밤을 기억해"
 },
 {
  "section": "v2",
  "who": "min",
  "ko": "누군가는 남아야 한다면",
  "id": "Jika harus ada yang tinggal",
