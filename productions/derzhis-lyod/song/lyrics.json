 "sections": [
  {
   "id": "intro",
   "label": "Intro",
   "note": "instrumental"
  },
  {
   "id": "v1",
   "label": "Verse 1",
   "lines": [
    {
     "who": "alyosha",
     "ru": "Сто двадцать пять граммов хлеба",
     "id": "Seratus dua puluh lima gram roti",
     "en": "A hundred and twenty-five grams of bread"
    },
    {
     "who": "alyosha",
     "ru": "Мама делит на троих",
     "id": "Ibu membaginya untuk bertiga",
     "en": "Mother divides it among three"
    },
    {
     "who": "alyosha",
     "ru": "Свой кусок кладёт Машутке",
     "id": "Bagiannya sendiri ia berikan pada Masha kecil",
     "en": "She gives her own piece to little Masha"
    },
    {
     "who": "alyosha",
     "ru": "«Я не голодна», — говорит",
     "id": "\"Aku tidak lapar,\" katanya",
     "en": "\"I am not hungry,\" she says"
    }
   ]
  },
  {
   "id": "v2",
   "label": "Verse 2",
   "lines": [
    {
     "who": "alyosha",
     "ru": "По озеру, по белой ночи",
     "id": "Melintasi danau, menembus malam putih",
     "en": "Across the lake, through the white night"
    },
    {
     "who": "alyosha",
     "ru": "Идёт колонна без огней",
     "id": "Konvoi berjalan tanpa lampu",
     "en": "The convoy moves with no lights"
    },
    {
     "who": "alyosha",
     "ru": "Мешки муки — туда, в блокаду",
     "id": "Karung tepung ke sana, ke kota yang terkepung",
     "en": "Sacks of flour go in, to the besieged city"
    },
    {
     "who": "alyosha",
     "ru": "Обратно — лица детей",
     "id": "Kembalinya, wajah anak-anak",
     "en": "Coming back, the faces of children"
    }
   ]
  },
  {
   "id": "pre",
   "label": "The convoy",
   "lines": [
    {
     "who": "alyosha",
     "ru": "Дверь открыта, руки на руле",
     "id": "Pintu terbuka, tangan di kemudi",
     "en": "The door open, hands on the wheel"
    },
    {
     "who": "choir",
     "ru": "Дверь открыта",
     "id": "Pintu terbuka",
     "en": "The door open"
    },
    {
     "who": "alyosha",
     "ru": "Фонари горят на льду",
     "id": "Lentera menyala di atas es",
     "en": "Lanterns burn on the ice"
    },
    {
     "who": "choir",
     "ru": "Горят, горят",
     "id": "Menyala, menyala",
     "en": "Burning, burning"
    }
   ]
  },
  {
   "id": "ch1",
   "label": "Chorus",
   "lines": [
    {
     "who": "alyosha",
     "ru": "Держись, лёд, держись",
     "id": "Bertahanlah, es, bertahanlah",
     "en": "Hold, ice, hold"
    },
    {
     "who": "choir",
     "ru": "Держись, держись",
     "id": "Bertahanlah, bertahanlah",
     "en": "Hold on, hold on"
    },
    {
     "who": "alyosha",
     "ru": "Ещё один рейс, ещё одна жизнь",
     "id": "Satu perjalanan lagi, satu nyawa lagi",
     "en": "One more run, one more life"
    },
    {
     "who": "alyosha",
     "ru": "Держись, лёд, держись",
     "id": "Bertahanlah, es, bertahanlah",
     "en": "Hold, ice, hold"
    },
    {
     "who": "choir",
     "ru": "Держись, держись",
     "id": "Bertahanlah, bertahanlah",
     "en": "Hold on, hold on"
    },
    {
     "who": "alyosha",
     "ru": "Я вернусь за тобой, только дождись",
     "id": "Aku akan kembali menjemputmu, tunggulah",
     "en": "I will come back for you, just wait"
    }
   ]
  },
  {
   "id": "v3",
   "label": "Verse 3",
   "lines": [
    {
     "who": "alyosha",
     "ru": "Я вернулся в нашу комнату",
     "id": "Aku kembali ke kamar kami",
     "en": "I came back to our room"
    },
    {
     "who": "alyosha",
     "ru": "Лампа больше не горит",
     "id": "Lampu tak lagi menyala",
     "en": "The lamp burns no more"
    },
    {
     "who": "alyosha",
     "ru": "Мама спит под старой шалью",
     "id": "Ibu tertidur di bawah selendang tuanya",
     "en": "Mother sleeps under her old shawl"
    },
    {
     "who": "alyosha",
     "ru": "Хлеб нетронутый лежит",
     "id": "Rotinya tergeletak tak tersentuh",
     "en": "Her bread lies untouched"
    },
    {
     "who": "alyosha",
     "ru": "Я закутал Машу в одеяло",
     "id": "Kubungkus Masha dengan selimut",
     "en": "I wrapped Masha in a blanket"
    },
    {
     "who": "alyosha",
     "ru": "И повёз по льду, по льду",
     "id": "Dan kubawa melintasi es, melintasi es",
     "en": "And drove her over the ice, over the ice"
    }
   ]
  },
